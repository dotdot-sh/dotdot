# Signing identity for the release commits and tags, set in the release repo only.
# Private SSH key file name in ~/.ssh/
RELEASE_SIGNING_KEY=
# Name and email on the release commits; the email must belong to the key's account.
RELEASE_AUTHOR_NAME=
RELEASE_AUTHOR_EMAIL=

# Where do you want to place the release repo, and what you'd want it to exclude?
RELEASE_DESTINATION=.ignore/release
# Paths left out of the release, one per line, from the project root.
RELEASE_EXCLUDE_FILE_LIST=release.exclude
# Branch the releases are committed to.
RELEASE_BRANCH=main

# Remotes to push to: RELEASE_REMOTE_<NAME> = release repo remote <name>
RELEASE_REMOTE_GITHUB=https://github.com/_USER_/_REPO_.git
RELEASE_REMOTE_HUGGINGFACE=https://huggingface.co/spaces/_USER_/_REPO_
