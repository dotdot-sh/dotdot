# dotdot's settings. The installer starts .dot/.env from this file; dotdot
# reads only .dot/.env, never this file. A setting dotdot needs and finds
# unset or empty stops it and says what to set.

# GitHub token for plugin downloads and GitHub tasks, as its owner, for this
# project only. Empty: your gh login.
GH_TOKEN=

# Where tasks are kept: plain (files in .dot/Tasks/) or github (issues).
# Switch with bash dot tasks:initialize.
TASKS_SERVICE=plain

# The owner/name repository GitHub tasks live in; set by tasks:initialize.
TASKS_GITHUB_REPO=
