{
  "autoUpdatesChannel": "latest",
  "model": "claude-opus-5-5",
  "outputStyle": "Concise",
  "alwaysThinkingEnabled": true,
  "defaultMode": "bypassPermissions",
  "enableAllProjectMcpServers": false,
  "disableBundledSkills": true,
  "syncClaudeAiSkills": false,
  "blockReadsOutsideWorkingDirectories": true,
  "showTurnDuration": true,
  "spinnerTipsEnabled": true,
  "terminalProgressBarEnabled": true,
  "env": {
    "FOO": "BAR!!",
    "IS_DEMO": false,
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": 90,
    "DISABLE_AUTOUPDATER": 0,
    "DISABLE_TELEMETRY": 1,
    "DISABLE_BUG_COMMAND": 1,
    "DISABLE_ERROR_REPORTING": 1,
    "CLAUDE_CODE_HIDE_ACCOUNT_INFO": 1
  },
  "permissions": {
    "deny": [
      "Bash(ssh-add)",
      "Bash(wget)",
      "Bash(curl)",
      "Bash(git * main)",
      "Bash(git remote*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git mv*)",
      "Bash(git rm*)",
      "Bash(git checkout*)",
      "Bash(git reset*)",
      "Bash(git stash*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Edit(./.git/**)",
      "Edit(./vendor/**)",
      "Edit(./node_modules/**)",
      "Read(./.git/**)",
      "Read(./.env)",
      "Read(./.dot/.env)",
      "Edit(./.dot/.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./node_modules/**)",
      "Read(./build)",
      "Read(./config/credentials.json)",
      "Read(.envrc)",
      "Read(~/.aws/**)",
      "Bash(.dot/.tooling/bin/*)",
      "Bash(bash .dot/.tooling/bin/*)",
      "Bash(sh .dot/.tooling/bin/*)"
    ],
    "ask": [],
    "allow": [
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(find ./**)",
      "Bash(bash dot emoji:hr *)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "🟡 ⏳⏳⏳⏳⏳⏳ 🟡"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/dot-statusline.sh\"",
    "padding": 0
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Do not re-read, re-grep, or re-fetch from disk anything already in your context window to refresh or verify it, and do not spawn a subagent to summarise it back to you: treat anything in your context window as known. This applies only to what is already loaded. Read, Grep, subagents and all your tools stay fully available for everything else.'"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Do not re-read, re-grep, or re-fetch from disk anything already in your context window to refresh or verify it, and do not spawn a subagent to summarise it back to you: treat anything in your context window as known. This applies only to what is already loaded. Read, Grep, subagents and all your tools stay fully available for everything else.'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/dot-emoji-hr/Stop.sh\""
          }
        ]
      }
    ]
  }
}
